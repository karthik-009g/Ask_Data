# =============================
# REQUIRED (Backend)
# =============================

# Strong random secret for JWT signing
JWT_SECRET_KEY=

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# MongoDB Atlas URI (must include default DB in path, e.g. /auth_db)
# Example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auth_db?retryWrites=true&w=majority
MONGO_URL=

# =============================
# OPTIONAL (Backend)
# =============================

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# AI provider selection priority:
# 1) GROQ_API_KEY (if present)
# 2) OPENAI_API_KEY (if GROQ is empty)
# 3) Fallback mode (if both are empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=Platform Super Admin


# =============================
# Frontend
# =============================

# Keep this as-is for local proxy routing unless your frontend deployment differs
NEXT_PUBLIC_API_BASE=/api/proxy
